# Web UI 定时任务配置示例
# 复制此文件为 schedule.yaml 并根据需要修改

# 是否启用定时任务
enabled: false

# 任务类型: daily, interval, cron
type: daily

# 每天执行的时间 (type=daily 时使用)
time: "10:00"

# 间隔小时数 (type=interval 时使用)
# hours: 6

# Cron 表达式 (type=cron 时使用)
# 格式: 分 时 日 月 星期
# 示例:
#   "0 10 * * *"      - 每天 10:00
#   "0 */6 * * *"     - 每 6 小时
#   "0 10 * * 1"      - 每周一 10:00
#   "30 9 * * 1-5"    - 工作日 9:30
# cron: "0 10 * * *"
